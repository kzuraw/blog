---
import Meta from "@/components/Meta.astro";
import nebulaSansRegular from "@fontsource/nebula-sans/files/nebula-sans-latin-400-normal.woff2?url";
import "@/styles/global.css";

const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Home", active: pathname === "/" },
  { href: "/blog", label: "Blog", active: pathname.startsWith("/blog") },
  { href: "/rss.xml", label: "RSS", active: false },
];
---

<!doctype html>
<html lang="en">
  <head>
    <slot name="meta"><Meta title="Krzysztof Żuraw" /></slot>
    <link
      rel="preload"
      href={nebulaSansRegular}
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="min-h-screen">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:bg-white focus:p-3"
      >Skip to content</a
    >
    <div class="mx-auto flex min-h-screen max-w-4xl flex-col px-5 sm:px-10">
      <header class="border-b-2 border-ink py-6 sm:py-10">
        <nav
          aria-label="Main navigation"
          class="flex flex-wrap items-center justify-between gap-5"
        >
          <a href="/" class="text-xl font-bold no-underline sm:text-2xl"
            >Krzysztof Żuraw</a
          >
          <ul role="list" class="flex border border-ink">
            {
              links.map(({ href, label, active }) => (
                <li class="border-r border-ink last:border-r-0">
                  <a
                    href={href}
                    aria-current={active ? "page" : undefined}
                    class:list={[
                      "block px-4 py-2 text-base no-underline hover:bg-ink hover:text-white focus-visible:relative focus-visible:z-10",
                      active && "bg-ink text-white",
                    ]}
                  >
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </header>
      <main
        id="main-content"
        tabindex="-1"
        class="min-w-0 flex-1 py-12 sm:py-16"
      >
        <slot name="content" />
      </main>
      <footer
        class="flex flex-wrap justify-between gap-4 border-t border-ink py-6 font-mono text-xs sm:text-sm"
      >
        <span>Krzysztof Żuraw</span>
        <a href="/rss.xml" class="underline"
          >Subscribe via RSS <span aria-hidden="true">↗</span></a
        >
      </footer>
    </div>
  </body>
</html>
