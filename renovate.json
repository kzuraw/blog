{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:all"],
  "timezone": "Europe/Warsaw",
  "schedule": ["* 6-9 * * 1"],
  "minimumReleaseAge": "7 days",
  "automerge": false,
  "packageRules": [
    {
      "description": "Keep TypeScript below 7 until astro check supports its native compiler API",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "groupName": "all dependencies",
    "groupSlug": "all",
    "schedule": ["* 6-9 * * 1"]
  }
}
